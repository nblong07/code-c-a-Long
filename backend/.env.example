# ============================================================
# .env.example — Cấu hình môi trường Backend
# Hướng dẫn: cp .env.example .env  rồi sửa giá trị bên dưới
# File .env đã được .gitignore — không bị commit lên GitHub
# ============================================================

# --- Model Configuration ---
# Tên model CLIP (phải giống model dùng khi upload_database.py)
# Lựa chọn: ViT-B-32 | ViT-L-14 | ViT-H-14
CLIP_MODEL_NAME=ViT-L-14
CLIP_PRETRAINED=laion2b_s32b_b82k

# Thiết bị tính toán: cuda hoặc cpu
DEVICE=cpu

# --- Milvus Database ---
# URI kết nối Milvus (chạy local Docker: http://localhost:19530)
MILVUS_URI=http://localhost:19530
MILVUS_DATABASE=default

# Tên collection trong Milvus (phải giống tên dùng khi upload)
COLLECTION_NAME=AIC25_fullbatch1

# Số lượng kết quả tìm kiếm tối đa
SEARCH_LIMIT=3000

# --- Server Configuration ---
# Cho phép CORS từ đâu (* = tất cả, hoặc chỉ định domain)
CORS_ORIGINS=*

# Số luồng xử lý song song
MAX_WORKERS=4

# Mức độ log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
