# ============================================================
# .env.example — Cấu hình môi trường Backend
# Hướng dẫn: cp .env.example .env rồi sửa giá trị bên dưới
# ============================================================

# --- Model Configuration ---
# PRIMARY MODEL: Google SigLIP 2 Giant (ViT-gopt-16-SigLIP2-384)
CLIP_MODEL_NAME=ViT-gopt-16-SigLIP2-384
CLIP_PRETRAINED=webli

# Thiết bị tính toán: cuda hoặc cpu
DEVICE=cuda

# --- Search Engine ---
SEARCH_LIMIT=1000

# --- Server Configuration ---
# Cho phép CORS từ đâu (* = tất cả, hoặc chỉ định domain)
CORS_ORIGINS=*

# Số luồng xử lý song song
MAX_WORKERS=8

# Mức độ log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

KEYFRAMES_DIR=D:/code-c-a-Long/data-keyframes
API_KEY=aic_challenge_secure_token_2026
